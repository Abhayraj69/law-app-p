# =============================================================================
# SLF Practice Management - Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE (REQUIRED — the server refuses to start without a working
# connection; there is no in-memory fallback anymore)
# -----------------------------------------------------------------------------
# Either set DATABASE_URL, or set the discrete PGHOST/PGDATABASE (and
# typically PGUSER/PGPASSWORD/PGPORT) vars below. DATABASE_URL wins if both
# are set.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=slf_vault
# PGUSER=postgres
# PGPASSWORD=your_password_here
# PGSSL=false
# DATABASE_URL=postgresql://user:pass@localhost:5432/slf_vault

# Run `npm run migrate` once against a fresh database to create the schema,
# then `npm run seed` to create the firm and the three demo users. Optional
# per-user passwords for the seed script (omit any of these to have the
# script generate a random one and print it once instead):
# SEED_JENNINGS_PASSWORD=
# SEED_ROSS_PASSWORD=
# SEED_NAIR_PASSWORD=

# -----------------------------------------------------------------------------
# AI PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------
# Choose one: "anthropic" | "openai" | "google" | "vercel-ai"
AI_PROVIDER=anthropic

# REQUIRED: API Key for the selected AI provider
# Get yours from: https://console.anthropic.com/ (for Anthropic)
# Get yours from: https://platform.openai.com/ (for OpenAI)
# Get yours from: https://aistudio.google.com/apikey (for Google/Gemini)
AI_PROVIDER_API_KEY=your_api_key_here

# Optional: Override default model per provider
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# OPENAI_MODEL=gpt-4o
# GOOGLE_MODEL=gemini-3.6-flash
# VERCEL_AI_MODEL=anthropic/claude-3-5-sonnet-20241022

# Optional: AI request timeout (ms)
AI_REQUEST_TIMEOUT_MS=30000

# Optional: Max tokens for AI responses
AI_MAX_TOKENS=4096

# Optional: Temperature for AI responses (0.0 - 1.0)
AI_TEMPERATURE=0.2

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# REQUIRED: JWT secret for signing login tokens. The server refuses to issue
# or verify tokens without a real value here (generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Comma-separated list of origins allowed to call the API cross-origin
# (e.g. https://app.example.com). Leave empty for a normal same-origin
# deployment where the frontend is served by this same server — that is
# the default and does not need this set. Do NOT use "*" in production.
# ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# MALWARE SCANNING (ClamAV)
# -----------------------------------------------------------------------------
# REQUIRED unless NODE_ENV=development: without a configured, reachable
# ClamAV daemon, the server refuses to boot at all (and, if the daemon
# becomes unreachable sometime after boot, every upload is refused with a
# 503 until it's reachable again) — see server/middleware/securityScanner.js.
# In development only, uploads fall back to extension + content-signature
# checks with no live antivirus scan.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# -----------------------------------------------------------------------------
# MESSAGE ENCRYPTION (application-level, at rest)
# -----------------------------------------------------------------------------
# REQUIRED unless NODE_ENV=development: conversation_messages.body is
# encrypted with AES-256-GCM under a data encryption key (DEK) that is
# itself envelope-encrypted under a KMS master key — see
# server/services/encryption/ and db/migrations/0006_message_encryption.sql.
# Outside development, KMS_KEY_ARN (a real AWS KMS customer master key)
# is required; the server refuses to boot without a reachable one.
# KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# In development only, MESSAGE_ENCRYPTION_LOCAL_KEY (a 32-byte base64
# value) is used instead — no AWS account needed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never use a local key like this outside development, and never commit it.
# MESSAGE_ENCRYPTION_LOCAL_KEY=

# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
# REQUIRED in production unless STORAGE_PROVIDER=s3: absolute path to a
# persistent volume mounted into the container. Without this, uploaded
# documents are written to the image's own writable layer and destroyed on
# every restart/redeploy.
# STORAGE_ROOT=/var/lib/slf/uploads

# Storage backend: "local" (default, disk at STORAGE_ROOT — correct for a
# single instance) or "s3" (required once running more than one instance,
# since most platforms can't share one read-write volume across replicas).
# STORAGE_PROVIDER=local
# STORAGE_S3_BUCKET=slf-vault-bucket
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_PREFIX=
# Only needed for an S3-compatible non-AWS endpoint (MinIO, R2, etc.) —
# leave unset to talk to real AWS S3. AWS credentials themselves are read
# from the standard AWS SDK credential chain (env vars, instance role,
# etc.), not from an app-specific variable.
# STORAGE_S3_ENDPOINT=

# -----------------------------------------------------------------------------
# EMAIL / NOTIFICATIONS (Optional)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# EMAIL_FROM=noreply@slf.law

# -----------------------------------------------------------------------------
# OBSERVABILITY (Optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL=info
# SENTRY_DSN=https://xxx@sentry.io/xxx

# -----------------------------------------------------------------------------
# PRODUCTION DEPLOYMENT (see docs/DEPLOYMENT_TASKS.md for the full reference)
# -----------------------------------------------------------------------------
# Number of reverse proxies (load balancer, ingress, CDN) in front of the
# app. Required whenever the app sits behind one, otherwise every caller is
# bucketed into a single rate-limit counter (an outage, not a nuisance).
# 1 behind a single load balancer, 2 behind a CDN in front of a load
# balancer. Never set to "true" — that trusts a client-supplied header.
# TRUST_PROXY_HOPS=1

# Verify (rather than merely encrypt) the database server's TLS certificate
# when PGSSL=true. Point at the provider's published CA bundle.
# PGSSLROOTCERT=/path/to/ca-bundle.pem
# Deliberate, visible escape hatch for a self-signed dev database only —
# never set true in production.
# PGSSL_INSECURE=false

# Share the auth rate limiter's counters across instances via Postgres
# instead of each instance's own in-memory counter. Leave unset for a
# single instance.
# RATE_LIMIT_STORE=postgres

# Drain window (ms) before a SIGTERM-triggered shutdown force-exits.
# SHUTDOWN_TIMEOUT_MS=15000

# Max size of a JSON request body. Uploads go through multipart, not JSON.
# JSON_BODY_LIMIT=1mb

# Path to the vendored Tesseract English language data (see Dockerfile) —
# required for OCR to work without outbound internet access.
# TESSERACT_LANG_PATH=/app/vendor/tessdata